# ==============================================================================
# VIXEL MEDIA — Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. Never commit .env.local or any file containing live secrets to git.
# 2. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or prefix it with NEXT_PUBLIC_.
# 3. Only NEXT_PUBLIC_ variables are bundled into client-side code.
# ==============================================================================

# Supabase Project API URL (Found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon / Publishable Key (Safe for client-side usage with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret (CRITICAL: Server-only! Used exclusively for administrative tasks & seed scripts. Bypasses RLS.)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-do-not-expose-to-browser

# Canonical Site URL (Used for auth redirects and absolute URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
